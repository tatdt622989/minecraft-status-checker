# Discord Bot 相關設定
BOT_TOKEN=你的Bot_Token請填這
GUILD_ID=你的Discord伺服器ID請填這
CHANNEL_ID=你的狀態頻道ID請填這
CHANNEL_ID2=你的玩家列表頻道ID請填這

# API 與 Minecraft 伺服器設定
API_PORT=3019
MC_SERVER_HOST=你的Minecraft伺服器IP請填這
MC_SERVER_PORT=25565

# 內部服務連線設定
# 若使用 docker-compose，會自動被覆蓋為 http://api:3019；若本地獨立運行，請保持 localhost 設定
API_BASE_URL=http://localhost:3019